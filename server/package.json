{
  "name": "taskforge-server",
  "version": "2.0.0",
  "private": true,
  "description": "Crash-safe background job processing on PostgreSQL and Redis",
  "author": "Sarvesh Mohite",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch api/server.ts",
    "worker": "node worker/worker.ts",
    "start": "node api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/policy.test.ts test/validation.test.ts test/limits.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/migration.integration.test.ts test/store.integration.test.ts test/system.integration.test.ts test/publicDemo.integration.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "pg": "^8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
