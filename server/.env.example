# Copy to .env and uncomment what you need. These are the defaults.

# HOST=127.0.0.1
# PORT=3000
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# CORS_ORIGINS=

# PGHOST=localhost
# PGPORT=5432
# PGADMIN_USERNAME=postgres
# PGADMIN_PASSWORD=postgres
# PGDATABASE=TaskForge

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# QUEUE_PREFIX=taskforge

# WORKER_NAME=anvil-1
# WORKER_CONCURRENCY=3
# LEASE_MS=10000
# HEARTBEAT_MS=1000
# SWEEP_MS=1000
# REDISPATCH_MS=5000
# SHUTDOWN_GRACE_MS=8000

# Scenario and crash-a-worker endpoints. Never enable on a public deployment.
# DEMO_MODE=false
