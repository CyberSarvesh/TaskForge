# Copy to .env and uncomment what you need. These are the defaults.

# HOST=127.0.0.1
# PORT=3000
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# CORS_ORIGINS=

# PGHOST=localhost
# PGPORT=5432
# PGADMIN_USERNAME=postgres
# PGADMIN_PASSWORD=postgres
# PGDATABASE=TaskForge

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# QUEUE_PREFIX=taskforge

# WORKER_NAME=anvil-1
# WORKER_CONCURRENCY=3
# LEASE_MS=10000
# HEARTBEAT_MS=1000
# SWEEP_MS=1000
# REDISPATCH_MS=5000
# SHUTDOWN_GRACE_MS=8000
# Work per round of a hash job. Lower it on a very small CPU (a power of two).
# HASH_COST=16384

# Scenario and crash-a-worker endpoints. In public, only together with PUBLIC_DEMO.
# DEMO_MODE=false

# Guardrails for a demo shared by anonymous visitors.
# PUBLIC_DEMO=false
# The header your proxy overwrites with the visitor's address, for rate limiting.
# CLIENT_IP_HEADER=cf-connecting-ip
